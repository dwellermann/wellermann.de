---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostItem from "../../../components/blog/PostItem.astro";
import Schema from "../../../components/seo/Schema.astro";
import { siteConfig } from "../../../config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return [...new Set(posts.map((post) => post.data.category).filter(Boolean))].map((category) => ({
    params: { category: category! },
    props: { category, posts: posts.filter((post) => post.data.category === category) },
  }));
}

const { category, posts } = Astro.props;
const url = new URL(Astro.url.pathname, siteConfig.url).href;
const metadata = { title: `Kategorie: ${category}`, description: `Beiträge der Kategorie ${category}.` };
---

<BaseLayout {metadata}>
  <Schema type="BreadcrumbList" data={{ breadcrumbs: [{ name: "Home", url: siteConfig.url }, { name: "Blog", url: new URL("/blog", siteConfig.url).href }, { name: String(category), url }] }} />
  <section class="frame px-6 py-16 max-md:px-5 max-md:py-10">
    <p class="label"><b>[01]</b> Kategorie</p>
    <h1 class="mt-4 text-[clamp(34px,5vw,58px)] font-bold tracking-[-.05em]">{category}</h1>
    <p class="mt-4 text-steel">{posts.length} {posts.length === 1 ? "Beitrag" : "Beiträge"} in dieser Kategorie.</p>
    <a class="mt-6 inline-block text-link hover:underline" href="/blog">← Alle Beiträge</a>
    <div class="mt-10 grid border border-rule md:grid-cols-2 lg:grid-cols-3">
      {posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).map((post, index) => <div class:list={["border-rule", index > 0 && "border-t md:border-t-0 md:border-l", index >= 3 && "lg:border-t"]}><PostItem {post} /></div>)}
    </div>
  </section>
</BaseLayout>
