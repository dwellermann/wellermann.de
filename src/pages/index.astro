---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import Hero from "../components/widgets/Hero.astro";
import Features from "../components/widgets/Features.astro";
import devImg from "../assets/images/dev_balanced.png";
import IchImg from "../assets/images/ich.jpeg";
import openSourceImg from "../assets/images/open-source.png";
import Content2 from "../components/widgets/Content2.astro";
import ServiceListLink from "../components/widgets/ServiceListLink.astro";
import Button from "../components/ui/Button.astro";
import { Icon } from "astro-icon/components";

const metadata = {
  title: `${siteConfig.name}`,
  description:
    "Die persönliche Website von Daniel Wellermann: BIM-Koordinator und Entwickler mit Interesse an digitalen Bauprozessen, IFC, GNU/Linux, Open Source und eigenen technischen Projekten.",
  ignoreTitleTemplate: true,
};
---

<BaseLayout {metadata}>
  <Hero
    title={`Daniel Wellermann<br class="hidden md:block" /> <span class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">Technik verstehen. Dinge bauen. Probleme lösen.</span>`}
    tagline="Gelernter Metallbauer · BIM-Koordinator · Entwickler"
    description="Beruflich beschäftige ich mich mit digitalen Bauprozessen, BIM und Softwareentwicklung. Darüber hinaus interessieren mich GNU/Linux, Server, Open Source und alles, was sich technisch entdecken, verstehen oder verbessern lässt."
    actions={[
      { variant: "primary", text: "Zum Blog", href: "/blog" },
      { variant: "secondary", text: "Docs on Codeberg", href: "https://codeberg.org/dwellermann", target: "_blank" , rel: "noopener noreferrer", icon: "lucide:mountain"}
    ]}
  />

  <Features
    id="features"
    tagline="Beruf, Projekte und Neugier"
    title="Womit ich mich beschäftige"
    subtitle="Ein Einblick in meine Arbeit und die Themen, die mich technisch interessieren."
    features={[
      {
        title: "GNU/Linux & Infrastruktur",
        description:
          "GNU/Linux begleitet mich seit vielen Jahren – auf Servern und am Desktop, unter anderem mit Debian, Ubuntu und Fedora. Mich beschäftigen Self-Hosting, Automatisierung und eine Infrastruktur, die nachvollziehbar bleibt.",
        icon: "lucide:server",
        iconClass: "bg-blue-500/10 text-blue-400",
      },
      {
        title: "Digitale Bauprozesse",
        description:
          "Als BIM-Koordinator und Entwickler beschäftige ich mich mit digitalen Bauprozessen und strukturierten Informationen. Ich entwickle Werkzeuge und Prozesse, die im Planungs- und Baualltag weiterhelfen.",
        icon: "lucide:building",
        iconClass: "bg-purple-500/10 text-purple-400",
      },
      {
        title: "Technik trifft Handwerk",
        description:
          "Elektronik, 3D-Druck, Werkstattprojekte und Hausautomatisierung: Ich probiere gern aus, wie Dinge funktionieren und ob sich eine Idee umsetzen lässt. Nicht jedes Projekt braucht einen Business Case.",
        icon: "lucide:printer",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
    ]}
  />

<Content2
    id="services"
    items={[
      {
        title: "Infrastruktur unter eigener Kontrolle",
        description:
          "Proxmox, LXC und Linux bilden die Grundlage meiner Infrastruktur. Für Container setze ich aktuell bevorzugt auf Podman und Quadlets. Docker gehört weiterhin zu meinem Werkzeugkasten. Entscheidend ist für mich eine zuverlässige und nachvollziehbare Lösung.",
        icon: "lucide:server",
      },
      {
        title: "Selbst hosten. Selbst entscheiden.",
        description:
          "Self-Hosting gibt mir Kontrolle darüber, wo meine Daten liegen und wie Dienste betrieben werden. Open Source ist dafür oft eine gute Grundlage, aber kein Selbstzweck. Ich entscheide pragmatisch, welche Lösung zum jeweiligen Zweck passt.",
        icon: "lucide:lock",
      },
      {
        title: "Mehr als nur bunte 3D-Modelle",
        description:
          "IFC-Modelle sind für mich weit mehr als Geometrie und Visualisierung. Mich interessieren vor allem die Informationen dahinter. Ich entwickle Werkzeuge und Prozesse, um IFC-Daten auszuwerten, Zusammenhänge sichtbar zu machen und die Informationen für Planung, Ausführung und Betrieb nutzbar zu machen.",
        icon: "lucide:box",
      },
      {
        title: "Code ist ein Werkzeug, kein Selbstzweck",
        description:
          "Ich entwickle gern Software – mit JavaScript, Go, Bash oder Python. Entscheidend ist für mich zuerst die fachliche Aufgabe: Welche Informationen oder Abläufe sollen besser funktionieren? Die Technologie ist ein Werkzeug, nicht das Ziel.",
        icon: "lucide:terminal",
      },
    ]}
    image={IchImg}
    imageAlt="Daniel Wellermann"
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Digitales Handwerk
      </h3>
      <p class="text-lg text-muted-foreground mb-4">
        Mich interessieren Lösungen, die im Alltag helfen – von der Auswertung strukturierter Bauinformationen bis zu Werkzeugen und Infrastruktur, die nachvollziehbar bleiben.
      </p>
    </Fragment>
  </Content2>

  <Features
    id="faq"
    tagline="Fragen & Antworten"
    title="Ein paar klare Standpunkte"
    subtitle="Meine Sicht auf BIM, Handwerk und Infrastruktur."
    features={[
      {
        title: "Ist BIM nur für Großprojekte sinnvoll?",
        description:
          "BIM ist für mich dann sinnvoll, wenn strukturierte Informationen über Geometrie hinaus genutzt werden. IFC kann Daten zwischen Anwendungen zugänglich machen – vorausgesetzt, Modellierung und Austausch sind sauber abgestimmt. Nicht jedes Vorhaben braucht denselben Prozess; wichtig ist, dass die Informationen den Beteiligten tatsächlich helfen.",
        icon: "lucide:database",
        iconClass: "bg-pink-500/10 text-pink-400",
      },
      {
        title: "Was haben Metallbau und Softwareentwicklung gemeinsam?",
        description:
          "Im Handwerk habe ich gelernt, Aufgaben praktisch zu erfassen, Arbeitsschritte zu planen und Ergebnisse zu prüfen. Das hilft mir auch in der Entwicklung: Erst verstehen, was gebraucht wird, dann ein passendes Werkzeug bauen. Die Verbindung ist für mich ziemlich naheliegend.",
        icon: "lucide:hammer",
        iconClass: "bg-purple-500/10 text-purple-400",
      },

{
        title: "Cloud, vServer oder eigene Hardware?",
        description:
          "Das hängt vom Dienst, den Anforderungen und dem Aufwand ab. Proxmox und LXC nutze ich für eigene Systeme; für gute Erreichbarkeit von außen kann ein gemieteter Server sinnvoll sein. Unabhängig vom Standort gehören automatische Backups, Updates und ein nachvollziehbarer Betrieb für mich dazu. Selbst hosten heißt auch, Verantwortung für Wartung und Sicherheit zu übernehmen.",
        icon: "lucide:shield-check",
        iconClass: "bg-primary/10 text-primary",
      },
    ]}
  />

   <Content2
    id="opensource"
    items={[]}
    image={openSourceImg}
    imageAlt="Community and Open Source"
    isReversed={true}
    actions={[
      { variant: "primary", text: "Mein Herzblut auf GitHub", href: "https://github.com/dwellermann", icon: "lucide:github" }
    ]}
  >
    <Fragment>
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">
        Open Source
      </h3>
      Seit ich 15 bin, begleitet mich GNU/Linux. Mit 17 habe ich mein erstes PHP-Liga-System für Counter-Strike 1.6 gehostet. Damals war ich vor allem Anwender: Ich habe getestet, Rückmeldungen gegeben und in Foren anderen geholfen. Auch das ist ein Beitrag zu Open Source.
      <br /><br />
      Open Source lebt nicht nur von Code, sondern ebenso von Dokumentation, Tests, Support und gemeinsamem Lernen. Ich habe viel durch die Arbeit anderer gelernt und schätze es, wenn Wissen zugänglich bleibt. So können Menschen aufeinander aufbauen – und eigene Systeme besser verstehen und kontrollieren.
      <br /><br />
      Mit meinen Tools und Konfigurationen möchte ich etwas davon zurückgeben. Dabei muss nicht jede Lösung offen sein: Entscheidend ist, dass sie zum Zweck passt und ich nachvollziehen kann, worauf ich mich einlasse.
    </Fragment>
  </Content2>

  <div class="relative px-4 py-16 sm:px-6 mx-auto max-w-7xl lg:px-8 lg:py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">
      Fragen zu einem Projekt, BIM oder GNU/Linux? Schreib mir gern.
    </h2>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <Button variant="primary" size="lg" href="/contact">
        <Icon name="lucide:mail" class="w-5 h-5 mr-2 -ml-1" />
        Kontakt aufnehmen
      </Button>
    </div>
  </div>

  {/*
  <ServiceListLink
    title="Netzwerk"
    subtitle="Wo du mich sicher erreichen kannst"
    services={[
      ...siteConfig.socialLinks.filter((social) => !["Facebook"].includes(social.name)).map((social) => (
        {
          name: social.name,
          description: social.describe,
          icon: `${social.icon}`,
          link: social.href,
        }
      ))
    ]}
  />
  */}
</BaseLayout>
