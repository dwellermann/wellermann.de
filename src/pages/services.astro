---
import BaseLayout from "../layouts/BaseLayout.astro";

const metadata = {
  title: "Schwerpunkte",
  description: "Fachliche Schwerpunkte von Daniel Wellermann.",
};

const areas = [
  ["BIM & IFC", "Strukturierte Informationen, die aus Modellen und Rohdaten im Planungs-, Bau- und Betriebsalltag nutzbar werden."],
  ["Infrastruktur", "Linux, Proxmox, Container und Self-Hosting – nachvollziehbar aufgebaut und unter eigener Kontrolle."],
  ["Entwicklung", "Kleine und große Werkzeuge, die fachliche Abläufe vereinfachen statt Technik um ihrer selbst willen einzusetzen."],
];
---

<BaseLayout {metadata}>
  <section class="frame px-6 py-20 max-md:px-5 max-md:py-14">
    <p class="label"><b>[01]</b> Schwerpunkte</p>
    <h1 class="mt-5 text-[clamp(38px,5vw,60px)] font-bold tracking-[-.05em]">Probleme praktisch lösen.</h1>
    <ul class="mt-10 grid border border-rule md:grid-cols-3">
      {areas.map(([title, description], index) => <li class:list={["p-6", index > 0 && "border-t border-rule md:border-t-0 md:border-l"]}><span class="label">0{index + 1}</span><h2 class="mt-4 text-xl font-bold">{title}</h2><p class="mt-3 text-[14px] leading-6 text-steel">{description}</p></li>)}
    </ul>
  </section>
</BaseLayout>
