---
import BaseLayout from "../layouts/BaseLayout.astro";

const metadata = {
  title: "Seite nicht gefunden",
  description: "Die gewünschte Seite gibt es nicht oder nicht mehr.",
};
---

<BaseLayout {metadata}>
  <section class="frame px-6 py-24 max-md:px-5 max-md:py-16">
    <p class="label"><b>[404]</b> Nicht gefunden</p>
    <h1 class="mt-5 text-[clamp(72px,16vw,180px)] font-bold leading-none tracking-[-.08em]">404</h1>
    <p class="mt-6 max-w-[55ch] leading-7 text-steel">Die gewünschte Seite gibt es nicht oder sie wurde verschoben. Über die Startseite, den Blog oder Kontakt findest du zurück.</p>
    <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/">Zur Startseite <span aria-hidden="true">-&gt;</span></a><a class="btn btn-ghost" href="/blog">Zum Blog</a></div>
  </section>
</BaseLayout>
