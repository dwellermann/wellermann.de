---
import BaseLayout from "../layouts/BaseLayout.astro";

const metadata = {
  title: "Experimente",
  description: "Technische Experimente und Komponenten von Daniel Wellermann.",
};
---

<BaseLayout {metadata}>
  <section class="frame px-6 py-20 max-md:px-5 max-md:py-14">
    <p class="label"><b>[01]</b> Experimente</p>
    <h1 class="mt-5 text-[clamp(38px,5vw,60px)] font-bold tracking-[-.05em]">Werkbank statt Showroom.</h1>
    <p class="mt-6 max-w-[60ch] leading-7 text-steel">Diese frühere Komponenten-Demoseite enthält keine eigenständigen Inhalte mehr. Aktuelle Projekte, Notizen und technische Erfahrungen stehen im Blog.</p>
    <a class="btn btn-primary mt-8" href="/blog">Zum Blog <span aria-hidden="true">-&gt;</span></a>
  </section>
</BaseLayout>
