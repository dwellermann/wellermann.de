---
import { type CollectionEntry, render } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { remarkPluginFrontmatter } = await render(post);
const readingTime = remarkPluginFrontmatter?.minutesRead
  ? `${Math.ceil(remarkPluginFrontmatter.minutesRead)} min`
  : "";
const formattedDate = post.data.pubDate.toLocaleDateString("de-DE", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<article data-post={post.data.category ?? "allgemein"} data-title={post.data.title.toLowerCase()}>
  <a href={`/blog/${post.id}`} class="group grid gap-4 p-5 max-md:px-0">
    {
      post.data.image && (
        <img src={post.data.image} alt="" class="aspect-[16/9] w-full border border-rule object-cover" loading="lazy" />
      )
    }
    <div>
      <p class="text-[11px] uppercase tracking-[.08em] text-steel">{post.data.category ?? "Allgemein"}</p>
      <h2 class="mt-3 text-[19px] font-bold leading-[1.25] tracking-[-.02em] text-ink group-hover:underline group-hover:underline-offset-4">{post.data.title}</h2>
      <p class="mt-3 line-clamp-3 text-[13px] leading-5 text-steel">{post.data.description}</p>
      <p class="mt-4 text-[12px] text-smoke"><time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>{readingTime && ` · ${readingTime}`}</p>
    </div>
  </a>
</article>
