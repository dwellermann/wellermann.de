---
import { siteConfig } from "../../config/site";
import ThemeToggle from "../ui/ThemeToggle.astro";

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-rule bg-canvas/95 backdrop-blur">
  <nav class="frame flex h-16 items-center gap-8 px-6 max-md:h-14 max-md:px-5" aria-label="Hauptnavigation">
    <a href="/" class="font-bold tracking-[-0.03em] text-ink">{siteConfig.name}</a>
    <ul class="hidden gap-7 text-[14px] md:flex">
      {
        siteConfig.navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "hover:text-ink",
                path === link.href ? "text-ink" : "text-steel",
              ]}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-4">
      <div class="hidden md:block">
        <ThemeToggle />
      </div>
      <a href="/contact" class="btn btn-primary px-3 py-2 text-[13px]">
        Kontakt
      </a>
      <button
        type="button"
        class="text-[13px] text-ink md:hidden"
        data-menu-open
        aria-haspopup="dialog"
      >
        [menu]
      </button>
    </div>
  </nav>
</header>

<dialog class="m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-canvas p-0 text-steel" aria-label="Navigation" data-mobile-menu>
  <div class="flex h-full flex-col">
    <div class="flex h-14 items-center border-b border-rule px-5">
      <a href="/" class="font-bold text-ink">{siteConfig.name}</a>
      <button type="button" class="ml-auto text-[13px] text-ink" data-menu-close>[schließen]</button>
    </div>
    <ul class="px-5 pt-3">
      {
        siteConfig.navLinks.map((link, index) => (
          <li>
            <a href={link.href} class="flex items-center gap-3 border-b border-rule py-4">
              <span class="text-[12px] text-smoke">{String(index + 1).padStart(2, "0")}</span>
              <span class="text-[28px] font-bold tracking-[-0.03em] text-ink">{link.text}</span>
              <span class="ml-auto text-stone" aria-hidden="true">-&gt;</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto flex items-center border-t border-rule px-5 py-6">
      <span class="label">Darstellung</span>
      <span class="ml-auto"><ThemeToggle /></span>
    </div>
  </div>
</dialog>

<style>
  :global(html:has(dialog[data-mobile-menu][open])) {
    overflow: hidden;
  }
</style>

<script>
  const menu = document.querySelector<HTMLDialogElement>("[data-mobile-menu]");
  document.querySelector("[data-menu-open]")?.addEventListener("click", () => menu?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => menu?.close());
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.close()));
</script>
